# WakaTime Configuration
WAKATIME_CLIENT_ID=your_wakatime_client_id
WAKATIME_CLIENT_SECRET=your_wakatime_client_secret
WAKATIME_REDIRECT_URI=http://localhost:3000/api/wakatime/callback
WAKATIME_ACCESS_TOKEN=your_wakatime_access_token
WAKATIME_REFRESH_TOKEN=your_wakatime_refresh_token

# Spotify Configuration
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret

# Auth Providers
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret
AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Web3Forms
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Umami Analytics
WEBSITE_ID=your_umami_website_id
UMAMI_API_KEY=your_umami_api_key

# GitHub Token (Optional)
GITHUB_READ_USER_TOKEN_PERSONAL=your_github_read_token

# Admin Email
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# Feedback Fish
NEXT_PUBLIC_FEEDBACK_FISH_ID=your_feedback_fish_id

# TimeZoneDB
NEXT_PUBLIC_TIMEZONEDB_API_KEY=your_timezonedb_api_key

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gmail (for Nodemailer or SMTP)
GMAIL_USER=your_email@example.com
GMAIL_PASS=your_email_password

# Cloudflare Turnstile
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your_turnstile_site_key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Calendly
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/yourname/30min

# Resend Email Service
RESEND_API_KEY=your_resend_api_key
RESEND_AUDIENCE_ID=your_resend_audience_id
